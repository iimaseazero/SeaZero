# Sea Zero — environment variables
#
# Copy to `.env.local` for local development, and set the same keys in your
# hosting provider (Vercel: Settings > Environment Variables) for deployment.
#
# `.gitignore` ignores `.env*` but keeps this template — never put real values here.

# ─── Required in production ─────────────────────────────────────────────────

# Signing key for the session JWT. WITHOUT THIS, AUTHENTICATION IS DISABLED in
# production — the app refuses to fall back to the development placeholder,
# because anyone reading the source could otherwise mint a token for any email
# (including the admin) and sign themselves in.
#
# Generate one:   openssl rand -base64 32
JWT_SECRET=

# ─── Required for sign-in, teams, submissions and the admin console ─────────
#
# The app reaches Cloudflare D1 over the REST API, so it runs anywhere — it does
# not need to be deployed on Cloudflare. Everything else (the simulator, all the
# charts, the Excel export) works without these; only persistence needs them.

# Cloudflare dashboard > right-hand sidebar, or Workers & Pages > Overview
CLOUDFLARE_ACCOUNT_ID=

# Already provisioned for this project — see wrangler.toml
CLOUDFLARE_D1_DATABASE_ID=58659fe5-b40e-4e2d-90f6-aaa58027e94b

# My Profile > API Tokens > Create Token.
# Scope it to exactly "Account > D1 > Edit" and nothing else.
CLOUDFLARE_API_TOKEN=

# ─── Optional ───────────────────────────────────────────────────────────────

# The single account allowed into /admin (upload routes, freeze controls,
# manage teams). Leave unset and nobody gets admin — the check fails closed.
ADMIN_EMAIL=
