# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Course material — HBS 9-625-100 is copyrighted and its notice explicitly
# forbids digitising, posting or transmitting it. Keep it out of any repo that
# might become public or get pushed to a hosting provider.
Project Case.pdf
*.pdf

# Generated decks reproduce Exhibit 2 and the case's cost figures, so they carry
# the same restriction as the PDF. Regenerate rather than commit.
*.pptx

# wrangler — local miniflare state, including a SQLite mirror of the D1
# database. Empty on a fresh checkout, but it holds real user emails and
# bcrypt password hashes the moment anyone runs the app against it locally.
.wrangler

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
